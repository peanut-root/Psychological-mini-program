/* pages/literature-detail/literature-detail.wxss */
.container {
  background-color: transparent;
  position: relative;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.header {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-left: 16rpx;
  padding-right: 16rpx;
  margin-top: -190rpx;
}
.main-content {
  padding-top: 0rpx;
  padding-bottom: 16rpx;
}
.detail-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
  -webkit-user-select: text;
  user-select: text;
}
.target-tip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  background-color: #FFF6D8;
  color: #7A4B00;
  font-size: 24rpx;
  font-weight: bold;
}
.article-section {
  padding: 24rpx 0 0;
  margin-top: 8rpx;
}
.article-section:first-child {
  padding-top: 0;
  margin-top: 0;
}
.article-section-target {
  padding: 24rpx;
  margin-top: 16rpx;
  border-left: 8rpx solid #F2B84B;
  border-radius: 8rpx;
  background-color: #FFF9E8;
}
.article-section-target:first-child {
  padding-top: 24rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #2F7DD8;
  line-height: 1.4;
  margin-bottom: 12rpx;
}
.article-section-target .section-title {
  color: #7A4B00;
  font-size: 32rpx;
}
.detail-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  display: block;
  -webkit-user-select: text;
  user-select: text;
}

/* 互动操作栏 */
.action-bar {
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx 0;
  margin: 8rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.action-icon.liked {
  color: #ff4757;
}
.action-text {
  font-size: 24rpx;
  color: #666666;
}

/* 评论输入框 */
.comment-input-container {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx;
  margin: 8rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.comment-input-box {
  border: 1rpx solid #e0e0e0;
  border-radius: 16rpx;
  overflow: hidden;
}
.comment-textarea {
  width: calc(100% - 48rpx);
  min-height: 120rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
}
.comment-actions {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background-color: #f9f9f9;
}
.cancel-btn, .submit-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
}
.cancel-btn {
  color: #666;
  margin-right: 16rpx;
}
.submit-btn {
  color: #fff;
  background-color: #4096FF;
}

/* 评论区域 */
.comments-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 8rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.comments-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}
.comment-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.comment-item:last-child {
  border-bottom: none;
}
.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.comment-user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
}
.comment-user-info {
  flex: 1;
}
.comment-user-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  display: block;
}
.comment-time {
  font-size: 22rpx;
  color: #999999;
  display: block;
}
.comment-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background-color: #F7F8FA;
}
.comment-like-icon {
  font-size: 24rpx;
}
.comment-like-count {
  font-size: 24rpx;
  color: #999999;
}
.comment-liked,
.comment-liked .comment-like-count {
  color: #2F7DD8;
}
.comment-content {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
  margin-top: 8rpx;
}
.comment-tools,
.reply-tools {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}
.comment-tool {
  font-size: 24rpx;
  color: #2F7DD8;
}
.comment-tool.danger {
  color: #E54D42;
}
.reply-list {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background-color: #F7F8FA;
}
.reply-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}
.reply-item:last-child {
  border-bottom: none;
}
.reply-header {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}
.reply-user {
  font-size: 24rpx;
  font-weight: bold;
  color: #333333;
}
.reply-time {
  font-size: 22rpx;
  color: #999999;
}
.reply-content {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.6;
  margin-top: 8rpx;
}
